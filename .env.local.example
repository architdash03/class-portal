NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_STUDENT_ID_EMAIL_DOMAIN=studentportal.local

# SERVER-ONLY — never prefix this with NEXT_PUBLIC_, never commit the real value.
# Found in Supabase: Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# SERVER-ONLY — a random secret string you make up yourself.
# Protects the /api/cron/generate-reminders route so only Vercel Cron can call it.
# Generate one with: openssl rand -hex 32
CRON_SECRET=your_random_secret_here
